{
  "$comment": "Living-docs map (docs/agents/workflow.md). A PR that changes a file matching an area's `paths` must also change one of its `docs`, or tick 'No spec impact' in the PR body. Globs: ** = any depth, * = one segment. Add an area when a new feature gets its doc.",
  "areas": [
    {
      "name": "auth",
      "paths": [
        "apps/api/src/http/security.ts",
        "apps/api/src/http/auth/**",
        "apps/api/src/features/auth/**",
        "apps/api/src/http/ratelimit*",
        "apps/api/src/http/ratelimit/**"
      ],
      "docs": [
        "apps/api/docs/AUTH-AND-ROLES.md",
        "apps/api/docs/AUTH-SETUP.md"
      ]
    },
    {
      "name": "capabilities",
      "paths": [
        "apps/api/src/features/capability/**"
      ],
      "docs": [
        "apps/api/docs/CAPABILITIES.md"
      ]
    },
    {
      "name": "apuntes (drive sync)",
      "paths": [
        "apps/api/src/features/drive/**",
        "apps/api/src/external/drive*",
        "apps/api/src/external/drive/**"
      ],
      "docs": [
        "apps/api/docs/DRIVE-SYNC.md"
      ]
    },
    {
      "name": "itba gateway",
      "paths": [
        "apps/api/src/external/itba*",
        "apps/api/src/external/itba/**"
      ],
      "docs": [
        "apps/api/docs/ITBA-GATEWAY.md"
      ]
    },
    {
      "name": "plans and data sync",
      "paths": [
        "apps/api/src/features/plan/**",
        "apps/api/src/features/sync/**",
        "apps/api/src/features/subject/**",
        "apps/web/src/api/plans.ts",
        "apps/web/src/utils/correlatividades.ts"
      ],
      "docs": [
        "apps/api/docs/PLANS.md"
      ]
    },
    {
      "name": "object storage",
      "paths": [
        "apps/api/src/features/media/**",
        "apps/api/src/infra/storage.ts"
      ],
      "docs": [
        "apps/api/docs/OBJECT-STORAGE.md"
      ]
    },
    {
      "name": "push notifications",
      "paths": [
        "apps/api/src/features/push/**",
        "apps/api/src/infra/push.ts"
      ],
      "docs": [
        "apps/api/docs/PUSH-NOTIFICATIONS.md"
      ]
    },
    {
      "name": "schedule corrections",
      "paths": [
        "apps/api/src/features/correction/**",
        "apps/web/src/scheduler/api/corrections.ts",
        "apps/web/src/api/corrections.ts"
      ],
      "docs": [
        "apps/api/docs/SCHEDULE-CORRECTIONS.md"
      ]
    },
    {
      "name": "subject reviews",
      "paths": [
        "apps/api/src/features/review/**",
        "apps/api/src/external/googleDirectory.ts",
        "apps/web/src/api/reviews.ts",
        "apps/web/src/components/apuntes/reviews/**"
      ],
      "docs": [
        "apps/api/docs/SUBJECT-REVIEWS.md"
      ]
    },
    {
      "name": "subject wiki",
      "paths": [
        "apps/api/src/features/kb/**",
        "apps/api/src/features/kb-admin/**",
        "apps/api/src/features/kb-pipeline/**",
        "apps/api/src/features/kb-reader/**",
        "apps/api/src/external/llm*",
        "apps/api/src/external/llm/**",
        "apps/api/scripts/kb/**",
        "apps/api/scripts/kb-import.sh"
      ],
      "docs": [
        "apps/api/docs/SUBJECT-WIKI.md",
        "apps/api/docs/SUBJECT-WIKI-PIPELINE.md",
        "apps/api/docs/SUBJECT-WIKI-ADMIN.md"
      ]
    },
    {
      "name": "weekly digest",
      "paths": [
        "apps/api/src/features/digest/**",
        "apps/api/src/features/mail/**",
        "apps/api/src/infra/mail.ts"
      ],
      "docs": [
        "apps/api/docs/WEEKLY-DIGEST.md"
      ]
    },
    {
      "name": "organizations",
      "paths": [
        "apps/api/src/features/news/access.ts",
        "apps/api/src/features/news/memberships.ts",
        "apps/api/src/features/news/organizations.ts",
        "apps/api/src/features/orgmail/**"
      ],
      "docs": [
        "apps/api/docs/ORGANIZATIONS.md"
      ]
    },
    {
      "name": "deploy (blue/green, job locks)",
      "paths": [
        "infra/scripts/**",
        "apps/api/docker-compose*.yml",
        "apps/api/Dockerfile",
        "apps/api/src/jobs/**",
        "apps/api/src/main.ts",
        "apps/api/src/db/migrate.ts"
      ],
      "docs": [
        "apps/api/docs/DEPLOY.md"
      ]
    },
    {
      "name": "hosting and CI",
      "paths": [
        "infra/**",
        ".github/workflows/**",
        ".github/spa-apps.json"
      ],
      "docs": [
        "AGENTS.md",
        "apps/web/AGENTS.md",
        "README.md",
        "CONTRIBUTING.md"
      ]
    },
    {
      "name": "ui system",
      "paths": [
        "apps/web/tailwind.config.*",
        "apps/web/src/index.css"
      ],
      "docs": [
        "docs/EDITORIAL_UI_SYSTEM.md"
      ]
    },
    {
      "name": "newsletter digest admin",
      "paths": [
        "apps/web/src/newsletter/pages/admin/AdminDigest*"
      ],
      "docs": [
        "apps/api/docs/WEEKLY-DIGEST.md"
      ]
    }
  ]
}

# Hosted (HTTP) server. Copy to .env (VPS: ~/CEITBA-MCP/.env).

# CEITBA API base URL including /api. In production, the internal address.
CEITBA_API_URL=http://ceitba-api:8080/api
# Public origin of this server (no trailing slash). The MCP endpoint is $MCP_PUBLIC_URL/mcp.
MCP_PUBLIC_URL=https://mcp.ceitba.org.ar
# AES-256-GCM key for the per-login CEITBA API keys stored in SQLite: openssl rand -base64 32
MCP_ENCRYPTION_KEY=
# Google OAuth web client used for the sign-in bridge. Authorized redirect URI:
#   $MCP_PUBLIC_URL/oauth/google/callback
# Its client id must also be in the API's AUTH_GOOGLE_MOBILE_AUDIENCES.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_HOSTED_DOMAIN=itba.edu.ar

# Optional
CEITBA_MCP_LANG=es
MCP_RATE_LIMIT_PER_MINUTE=60
MCP_ACCESS_TOKEN_TTL_SECONDS=3600
MCP_GRANT_TTL_DAYS=90
MCP_ALLOW_API_KEY_BEARER=true
MCP_TRUST_PROXY_HOPS=1
LOG_LEVEL=info

# Local stdio server only (bun src/stdio.ts)
# CEITBA_API_URL=https://ceitba.org.ar/api
# CEITBA_API_KEY=ceitba_...
# CEITBA_MCP_ALLOW_WRITES=false

{
  "name": "@ceitba/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server for the CEITBA API (stdio + Streamable HTTP with OAuth 2.1)",
  "bin": {
    "ceitba-mcp": "./src/stdio.ts"
  },
  "scripts": {
    "dev": "bun --watch src/http.ts",
    "start": "bun src/http.ts",
    "stdio": "bun src/stdio.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@ceitba/scheduler-core": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/express": "5.0.6",
    "typescript": "5.9.3"
  }
}

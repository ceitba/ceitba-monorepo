# Local Drive sync (Apuntes) stack: docker-compose.drive.yml, project
# "ceitba-drive". Runs next to the regular dev stack (ports 5432/8080/9000)
# without touching it. Copy to .env.drive and fill in:
#
#   cp .env.drive.example .env.drive
#   docker compose --env-file .env.drive -f docker-compose.drive.yml up -d --build
#
# API http://localhost:8081/api  (Swagger: /api/docs), Postgres 127.0.0.1:5433,
# MinIO S3 http://localhost:9002 (console http://localhost:9003).

# Required by the API (openssl rand -base64 32).
AUTH_JWT_SECRET=

# Separate cookie so this stack's session does not clash with the dev stack's
# ceitba_session on localhost (cookies ignore ports).
AUTH_COOKIE_NAME=ceitba_drive_session

# POST /v1/auth/dev-login {email, name, staff}: sign in without Google.
# Only works with SPRING_PROFILES_ACTIVE=dev (set by the compose file).
AUTH_DEV_LOGIN_ENABLED=true
AUTH_ALLOWED_DOMAINS=itba.edu.ar
AUTH_ALLOWED_EMAILS=

# MinIO root + the API's service user (any values; local only).
MINIO_ROOT_USER=ceitba-root
MINIO_ROOT_PASSWORD=change-me-local-root
STORAGE_ACCESS_KEY_ID=ceitba-api
STORAGE_SECRET_ACCESS_KEY=change-me-local-secret

# --- Drive ---
# Either a real service account (base64 of its key JSON):
#   base64 -i service-account.json | tr -d '\n'
# Students share their folder with the key's client_email (GET /v1/me/drive/info).
DRIVE_SYNC_SERVICE_ACCOUNT_JSON=
# ...or the in-memory fake (no Google). Each email below gets a demo folder
# "demo-<local part>" it owns: register it with folderUrl "demo-alumno1".
DRIVE_SYNC_USE_FAKE=false
DRIVE_SYNC_FAKE_DEMO_OWNERS=alumno1@itba.edu.ar,alumno2@itba.edu.ar
# Scheduled job (registration and POST .../sync trigger a sync regardless).
DRIVE_SYNC_ENABLED=true
DRIVE_SYNC_INTERVAL=PT5M
DRIVE_SYNC_RUN_BUDGET=PT5M
DRIVE_SYNC_MAX_FILE_BYTES=52428800

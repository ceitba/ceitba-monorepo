generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "wiki"]
}

// SCHEMA PUBLIC
model User {
  id               String   @id @default(uuid()) @db.Uuid
  email            String   @unique @db.VarChar(255)
  fileNumber       Int?     @unique @map("file_number") @db.Integer
  careerId         String?  @map("career_id") @db.Uuid
  plan             String?  @map("plan") @db.VarChar(255)
  name             String?  @map("name") @db.VarChar(255)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz
  preferedLanguage String?  @default("es") @map("prefered_language") @db.VarChar(5)

  ceitbaStaff CeitbaStaff?

subjectDifficulties SubjectDifficulty[]   @relation("User_SubjectDifficulties")
  subjectComments     SubjectComment[]      @relation("User_SubjectComments")
  subjectCommentVotes SubjectCommentVote[]  @relation("User_SubjectCommentVotes")
  subjectNotes        SubjectNote[]         @relation("User_SubjectNotes")
  subjectNoteVotes    SubjectNoteVote[]     @relation("User_SubjectNoteVotes")
  careerNotes         CareerNote[]          @relation("User_CareerNotes")
  careerNoteVotes     CareerNoteVote[]      @relation("User_CareerNoteVotes")
  wikiPagesEdited     SubjectWikiPage[]     @relation("User_WikiPagesEdited")
  wikiProposalsAuthored SubjectWikiEditProposal[] @relation("User_WikiProposalsAuthored")
  wikiProposalsReviewed SubjectWikiEditProposal[] @relation("User_WikiProposalsReviewed")

  @@index([email])
  @@index([fileNumber])
  @@index([careerId])
  @@index([plan])
  @@index([name])
  @@map("user")
  @@schema("public")
}

model Career {
  id        String   @id @db.VarChar(25)
  name      String   @db.VarChar(255)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  plans Plan[]

  careerNotes CareerNote[] @relation("Career_CareerNotes")

  @@index([id])
  @@map("careers")
  @@schema("public")
}

model Plan {
  id        String   @id @db.VarChar(25)
  careerId  String   @map("career_id") @db.VarChar(25)
  name      String?  @db.VarChar(255)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  career Career @relation(fields: [careerId], references: [id])

  @@index([careerId])
  @@map("plan")
  @@schema("public")
}

model Subject {
  id        String   @id @db.VarChar(25)
  name      String   @db.VarChar(255)
  credits   Int      @default(0) @db.Integer
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz


  difficulties SubjectDifficulty[] @relation("Subject_Difficulties")
  comments     SubjectComment[]    @relation("Subject_Comments")
  notes        SubjectNote[]       @relation("Subject_Notes")
  wikiPage     SubjectWikiPage?    @relation("Subject_WikiPage")
  wikiProposals SubjectWikiEditProposal[] @relation("Subject_WikiProposals")

  @@index([id])
  @@map("subject")
  @@schema("public")
}

// 93.12 A
// 93.12 B
// 93.12 C
model Commission {
  id               String      @id @db.VarChar(20)
  subjectCode      String      @map("subject_code") @db.VarChar(10)
  commissionName   String      @map("commission_name") @db.VarChar(50)
  courseStart      DateTime    @map("course_start") @db.Date
  courseEnd        DateTime    @map("course_end") @db.Date
  enrolledStudents Int         @map("enrolled_students") @db.Integer
  quota            Int         @db.Integer
  subjectType      SubjectType @default(SEMESTRAL) @map("subject_type")

  times CommissionTime[]

  @@map("commission")
  @@schema("public")
}

enum SubjectType {
  ANNUAL
  SEMESTRAL
  SAMINARY

  @@map("subject_type")
  @@schema("public")
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY

  @@map("day_of_week")
  @@schema("public")
}

model PlanSubject {
  dependencies    String[] @db.VarChar(255)
  section         String   @db.VarChar(255)
  subjectId       String   @map("subject_id") @db.VarChar(32)
  planId          String   @map("plan_id") @db.VarChar(32)
  year            Int      @default(0) @db.Integer
  semester        Int      @default(0) @db.Integer
  creditsRequired Int      @map("credits_required") @db.Integer

  @@id([subjectId, planId])
  @@map("plan_subject")
  @@schema("public")
}

model CommissionTime {
  courseId  String    @map("course_id") @db.VarChar(20)
  day       DayOfWeek
  classroom String    @db.VarChar(50)
  building  String    @db.VarChar(50)
  hourFrom  DateTime  @map("hour_from") @db.Time
  hourTo    DateTime  @map("hour_to") @db.Time

  commission Commission @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([courseId, day, hourFrom])
  @@map("commission_time")
  @@schema("public")
}

enum CeitbaBranch {
  IT
  MEDIA
  INFRASTRUCTURE
  NAUTICAL
  EVENTS
  DIRECTIVES

  @@map("ceitba_branch")
  @@schema("public")
}

enum CeitbaStaffRole {
  PRESIDENT
  VICEPRESIDENT
  SECRETARY
  TREASURER
  LEADER
  MEMBER

  @@map("ceitba_staff_role")
  @@schema("public")
}

model CeitbaStaff {
  userId String          @id @map("user_id") @db.Uuid
  branch CeitbaBranch    @map("branch")
  role   CeitbaStaffRole @default(MEMBER) @map("role")
  start  DateTime        @map("start") @db.Timestamptz
  end    DateTime        @map("end") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@map("ceitba_staff")
  @@schema("public")
}

// SCHEMA WIKI
enum VoteType {
  LIKE
  DISLIKE

  @@map("vote_type")
  @@schema("wiki")
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("proposal_status")
  @@schema("wiki")
}
model SubjectDifficulty {
  subjectId String  @map("subject_id") @db.VarChar(25)
  userId    String  @map("user_id")    @db.Uuid
  value     Int     @db.Integer
  createdAt DateTime @default(now())   @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt        @map("updated_at") @db.Timestamptz

  subject Subject @relation("Subject_Difficulties", fields: [subjectId], references: [id])
  user    User    @relation("User_SubjectDifficulties", fields: [userId],    references: [id])

  @@id([subjectId, userId])
  @@index([subjectId])
  @@index([userId])
  @@map("subject_difficulty")
  @@schema("wiki")
}

model SubjectComment {
  id        String   @id @default(uuid()) @db.Uuid
  subjectId String   @map("subject_id") @db.VarChar(25)
  userId    String   @map("user_id")    @db.Uuid
  content   String   @db.Text
  createdAt DateTime @default(now())     @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt          @map("updated_at") @db.Timestamptz

  subject Subject @relation("Subject_Comments", fields: [subjectId], references: [id])
  user    User    @relation("User_SubjectComments", fields: [userId],    references: [id])
  votes   SubjectCommentVote[]

  @@index([subjectId])
  @@index([userId])
  @@map("subject_comment")
  @@schema("wiki")
}

model SubjectCommentVote {
  commentId String   @map("comment_id") @db.Uuid
  userId    String   @map("user_id")    @db.Uuid
  type      VoteType

  comment SubjectComment @relation(fields: [commentId], references: [id])
  user    User           @relation("User_SubjectCommentVotes", fields: [userId],    references: [id])

  @@id([commentId, userId])
  @@index([userId])
  @@map("subject_comment_vote")
  @@schema("wiki")
}

model SubjectNote {
  id         String   @id @default(uuid()) @db.Uuid
  subjectId  String   @map("subject_id") @db.VarChar(25)
  ownerName  String   @map("owner_name") @db.VarChar(255)
  link       String   @db.VarChar(1024)
  uploaderId String   @map("uploader_id") @db.Uuid
  createdAt  DateTime @default(now())      @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt           @map("updated_at") @db.Timestamptz

  subject  Subject @relation("Subject_Notes", fields: [subjectId], references: [id])
  uploader User    @relation("User_SubjectNotes", fields: [uploaderId], references: [id])
  votes    SubjectNoteVote[]

  @@index([subjectId])
  @@index([uploaderId])
  @@map("subject_note")
  @@schema("wiki")
}

model SubjectNoteVote {
  noteId String   @map("note_id") @db.Uuid
  userId String   @map("user_id") @db.Uuid
  type   VoteType

  note SubjectNote @relation(fields: [noteId], references: [id])
  user User        @relation("User_SubjectNoteVotes", fields: [userId], references: [id])

  @@id([noteId, userId])
  @@index([userId])
  @@map("subject_note_vote")
  @@schema("wiki")
}

model CareerNote {
  id         String   @id @default(uuid()) @db.Uuid
  careerId   String   @map("career_id")  @db.VarChar(25)
  name       String   @db.VarChar(255)
  ownerName  String   @map("owner_name") @db.VarChar(255)
  link       String   @db.VarChar(1024)
  uploaderId String   @map("uploader_id") @db.Uuid
  createdAt  DateTime @default(now())      @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt           @map("updated_at") @db.Timestamptz

  career   Career @relation("Career_CareerNotes", fields: [careerId], references: [id])
  uploader User   @relation("User_CareerNotes", fields: [uploaderId], references: [id])
  votes    CareerNoteVote[]

  @@index([careerId])
  @@index([uploaderId])
  @@map("career_note")
  @@schema("wiki")
}

model CareerNoteVote {
  noteId String   @map("note_id") @db.Uuid
  userId String   @map("user_id") @db.Uuid
  type   VoteType

  note CareerNote @relation(fields: [noteId], references: [id])
  user User       @relation("User_CareerNoteVotes", fields: [userId], references: [id])

  @@id([noteId, userId])
  @@index([userId])
  @@map("career_note_vote")
  @@schema("wiki")
}

model SubjectWikiPage {
  subjectId  String   @id @map("subject_id") @db.VarChar(25)
  content    String   @db.Text
  updatedBy  String   @map("updated_by") @db.Uuid
  updatedAt  DateTime @updatedAt          @map("updated_at") @db.Timestamptz
  createdAt  DateTime @default(now())     @map("created_at") @db.Timestamptz

  subject  Subject @relation("Subject_WikiPage", fields: [subjectId], references: [id])
  editor   User    @relation("User_WikiPagesEdited", fields: [updatedBy], references: [id])

  @@map("subject_wiki_page")
  @@schema("wiki")
}

model SubjectWikiEditProposal {
  id               String         @id @default(uuid()) @db.Uuid
  subjectId        String         @map("subject_id") @db.VarChar(25)
  proposedBy       String         @map("proposed_by") @db.Uuid
  proposedAt       DateTime       @default(now())     @map("proposed_at") @db.Timestamptz
  proposedContent  String         @map("proposed_content") @db.Text
  status           ProposalStatus @default(PENDING)
  reviewedBy       String?        @map("reviewed_by") @db.Uuid
  reviewedAt       DateTime?      @map("reviewed_at") @db.Timestamptz
  reviewComment    String?        @map("review_comment") @db.VarChar(1024)

  subject  Subject @relation("Subject_WikiProposals", fields: [subjectId], references: [id])
  proposer User    @relation("User_WikiProposalsAuthored", fields: [proposedBy], references: [id])
  reviewer User?   @relation("User_WikiProposalsReviewed", fields: [reviewedBy], references: [id])

  @@index([subjectId])
  @@index([proposedBy])
  @@index([reviewedBy])
  @@map("subject_wiki_edit_proposal")
  @@schema("wiki")
}

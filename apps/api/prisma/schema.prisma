generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// TODO: Complete
model User {
  id                         String    @id @default(uuid()) @db.Uuid
  email                      String    @unique @db.VarChar(255)
  
  @@map("users")
}


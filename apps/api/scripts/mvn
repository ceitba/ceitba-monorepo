#!/usr/bin/env bash
# Run Maven against the project. Prefers a host JDK 21 (faster, simpler,
# Testcontainers works without DinD gymnastics). Falls back to a containerized
# JDK if no java is found, with the Docker socket mounted so Testcontainers
# can spin up sibling containers.
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# Auto-detect JDK 21 in common locations.
detect_java_home() {
  if [[ -n "${JAVA_HOME:-}" && -x "$JAVA_HOME/bin/java" ]]; then
    echo "$JAVA_HOME"; return
  fi
  for d in "$HOME/.local/jdk"/jdk-21* /usr/lib/jvm/java-21-* /opt/java/openjdk; do
    if [[ -x "$d/bin/java" ]]; then echo "$d"; return; fi
  done
  if command -v java >/dev/null 2>&1; then
    java_home=$(java -XshowSettings:properties -version 2>&1 | awk -F' = ' '/java.home/{print $2; exit}')
    [[ -n "$java_home" ]] && echo "$java_home"
  fi
}

JAVA_HOME_DETECTED="$(detect_java_home)"

if [[ -n "$JAVA_HOME_DETECTED" ]]; then
  export JAVA_HOME="$JAVA_HOME_DETECTED"
  export PATH="$JAVA_HOME/bin:$PATH"
  cd "$PROJECT_ROOT"
  exec ./mvnw "$@"
fi

# Fallback: containerized Maven. Mounts the Docker socket so Testcontainers
# can spin up sibling containers and uses host networking so the test JVM can
# reach those containers on localhost.
M2_CACHE="${M2_CACHE:-$HOME/.m2}"
mkdir -p "$M2_CACHE"

exec docker run --rm \
  --network host \
  -v "$PROJECT_ROOT/../..":/repo \
  -v "$M2_CACHE":/root/.m2 \
  -v /var/run/docker.sock:/var/run/docker.sock \
  -e TESTCONTAINERS_HOST_OVERRIDE=localhost \
  -e DOCKER_HOST=unix:///var/run/docker.sock \
  -w /repo/apps/api \
  eclipse-temurin:21-jdk \
  ./mvnw "$@"

# --- Server ---
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- Database ---
POSTGRES_DB=ceitba_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ceitba_password
DATABASE_URL=jdbc:postgresql://localhost:5432/ceitba_db

# --- ITBA External API ---
ITBA_API_BASE_URL=https://example.com
ITBA_API_TOKEN=your_itba_api_token_here
ITBA_API_TIMEOUT=30000
# Set to true in tests/local-dev to swap in FakeItbaApiClient (no network calls).
ITBA_API_USE_FAKE=false

# --- Auth ---
# Comma-separated list. Email is admitted if it ends with @<one_of_these>.
AUTH_ALLOWED_DOMAINS=itba.edu.ar
# Comma-separated explicit allowlist for non-domain users (staff/alumni on personal addresses).
AUTH_ALLOWED_EMAILS=
# Required for /v1/sync/** endpoints.
# openssl rand -hex 32
AUTH_SYNC_API_KEY=change-me-in-prod

# --- Sync ---
# Set to true to enable the @Scheduled twice-daily sync job (00:00 and 12:00).
SYNC_ENABLED=false

# --- Rate limiting (per client IP, in-memory) ---
# Applies to /v1/auth/** except /v1/auth/me and /v1/auth/api-keys/**.
# (The docker-compose ceitba-api service passes these through.)
RATE_LIMIT_ENABLED=true
# Use the right-most X-Forwarded-For entry (set by Caddy). Only honoured when
# the direct peer is a private/loopback address (the proxy). Set to false when
# the API is exposed without a reverse proxy.
RATE_LIMIT_TRUST_FORWARDED_FOR=true
RATE_LIMIT_AUTH_CAPACITY=20
RATE_LIMIT_AUTH_PERIOD=1m
# Separate bucket for POST /v1/auth/google/mobile (class-wide installs behind
# the campus NAT).
RATE_LIMIT_MOBILE_LOGIN_CAPACITY=120
RATE_LIMIT_MOBILE_LOGIN_PERIOD=1m
# Separate bucket for POST /v1/auth/refresh (mobile apps refresh every ~15 min).
RATE_LIMIT_REFRESH_CAPACITY=120
RATE_LIMIT_REFRESH_PERIOD=1m
# Separate, strict bucket for POST /v1/auth/review-login (store review account).
RATE_LIMIT_REVIEW_LOGIN_CAPACITY=10
RATE_LIMIT_REVIEW_LOGIN_PERIOD=1m

# --- Google OAuth ---
# openssl rand -base64 32
AUTH_JWT_SECRET=
# Optional root secret for keyed hashes (proposal attachment keys, imported
# Firestore comment ids, article-vote fingerprints, analytics IP hashes).
# Empty = keys are derived from AUTH_JWT_SECRET, so rotating that secret
# invalidates unattached uploads, makes a Firestore import re-run duplicate
# legacy comments and lets past article voters vote once more. Setting or
# changing this later has the same effects. openssl rand -base64 32
CONTENT_HMAC_SECRET=
# Web session cookie lifetime.
AUTH_JWT_TTL_DAYS=7
# `iss` of the JWTs we issue (the public API base URL).
AUTH_JWT_ISSUER=https://ceitba.org.ar/api
# Phase-in: false = iss/aud checked only on tokens that carry them. Set to true
# once all pre-B1 web cookies have expired (B1 deploy date + AUTH_JWT_TTL_DAYS).
AUTH_JWT_ENFORCE_ISS_AUD=false
# Mobile app tokens (POST /v1/auth/google/mobile, /v1/auth/refresh).
AUTH_MOBILE_ACCESS_TTL=15m
AUTH_REFRESH_TTL=60d
# A rotated refresh token re-presented within this window (lost response) gets
# a new successor instead of revoking the whole session family. 0 disables.
AUTH_REFRESH_REUSE_GRACE=60s
# Comma-separated OAuth client IDs accepted as `aud` of Google ID tokens from
# the mobile app: the web client ID below (the app's serverClientId) and, if
# the iOS app does not use serverClientId, the iOS client ID. All clients must
# be in the same Google Cloud project. Empty = mobile login disabled.
AUTH_GOOGLE_MOBILE_AUDIENCES=

# --- App Store / Play review login (POST /v1/auth/review-login) ---
# Email + password login for ONE store-review account (Apple/Google reviewers
# cannot reliably use Google Sign-In). Leave BOTH empty (the default) to
# disable it: the endpoint then answers 404. Enable it only while a review is
# pending and unset it afterwards (docs/AUTH-AND-ROLES.md).
# The email may be any address (it bypasses AUTH_ALLOWED_* for this login only).
# Store ONLY the bcrypt hash of the password, never the password itself:
#   htpasswd -bnBC 12 "" 'the-password' | tr -d ':\n'
#   # no htpasswd? docker run --rm httpd:2.4-alpine htpasswd -bnBC 12 "" 'the-password' | tr -d ':\n'
# ($2a$, $2b$ and $2y$ hashes all work.)
# The hash contains `$`: ALWAYS wrap it in SINGLE quotes here, or docker compose
# expands the `$...` parts (e.g. `$<salt+hash>`) as variables and silently
# corrupts it. Paste exactly the 60-char hash: no trailing characters (zsh
# prints a `%` after output without a final newline; do not copy it).
# Verify what the container
# will get (compose prints every `$` doubled, so expect `$$2a$$12$$`):
#   docker compose config | grep -oE 'REVIEW_LOGIN_PASSWORD_HASH: .{0,10}'
# and the full shape (must print 1):
#   docker compose config | grep -cE 'REVIEW_LOGIN_PASSWORD_HASH: \$\$2[aby]\$\$[0-9]{2}\$\$[./A-Za-z0-9]{53}$'
# A bad value does NOT stop the API: it logs
# "ERROR Review login: MISCONFIGURED" and review login stays disabled (404).
REVIEW_LOGIN_EMAIL=
REVIEW_LOGIN_PASSWORD_HASH=
# REVIEW_LOGIN_PASSWORD_HASH='$2a$12$...'

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/callback

# --- Session cookie ---
# HttpOnly is forced in code; the rest is configurable so prod can flip Secure
# on and pin the cookie to ceitba.org.ar, while local dev runs in plain http.
AUTH_COOKIE_NAME=ceitba_session
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_PATH=/

FRONTEND_URL=http://localhost:3000

# --- Mobile app release control (GET /v1/app/config) ---
MOBILE_MIN_VERSION=0.0.0
MOBILE_LATEST_VERSION=0.0.0
MOBILE_MAINTENANCE=false

# --- Push notifications (FCM, docs/PUSH-NOTIFICATIONS.md) ---
# Service-account key JSON of the app's Firebase project, raw or base64
# (base64 -i key.json), or a path to the file. Both empty = pushes disabled
# (device registration still works). Invalid credentials fail startup.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

# --- Object storage (S3-compatible; self-hosted MinIO in prod) ---
# docs/OBJECT-STORAGE.md. Presigned direct uploads for CMS images and proposal
# attachments. Leave STORAGE_ENDPOINT (or any of the connection values) empty
# to disable uploads (the sign-upload endpoints answer 501). The older R2_*
# names still work as fallbacks.
#
# MinIO admin (root) credentials: used only by the minio-init container and by
# operators, never by the API. Required by docker compose. openssl rand -hex 32
MINIO_ROOT_USER=ceitba-root
MINIO_ROOT_PASSWORD=change-me-min-8-chars
# Web console on 127.0.0.1:<port> of the host (SSH tunnel in prod).
MINIO_CONSOLE_PORT=9001
# The API's MinIO service user: minio-init creates it with PutObject/GetObject
# on STORAGE_BUCKET only. Required by docker compose. openssl rand -hex 32
STORAGE_ACCESS_KEY_ID=ceitba-api
STORAGE_SECRET_ACCESS_KEY=change-me-min-8-chars
STORAGE_BUCKET=ceitba-media
# Prod: https://ceitba.org.ar (Caddy proxies /ceitba-media/* to MinIO; the
# host is part of the signature, so it must be the URL phones reach) and
# https://ceitba.org.ar/ceitba-media. Empty = uploads disabled (local dev).
STORAGE_ENDPOINT=
STORAGE_PUBLIC_URL=
STORAGE_REGION=us-east-1
STORAGE_PRESIGN_TTL=10m
# Per-user quota on proposal attachment upload signing.
RATE_LIMIT_PROPOSAL_ATTACHMENTS_CAPACITY=30
RATE_LIMIT_PROPOSAL_ATTACHMENTS_PERIOD=1h
# Per-user quotas on POST /v1/proposals and POST /v1/proposals/{id}/comments.
RATE_LIMIT_PROPOSALS_CAPACITY=10
RATE_LIMIT_PROPOSALS_PERIOD=1h
RATE_LIMIT_PROPOSAL_COMMENTS_CAPACITY=30
RATE_LIMIT_PROPOSAL_COMMENTS_PERIOD=10m

# --- Drive sync / Apuntes (docs/DRIVE-SYNC.md) ---
# Base64 of the bot service-account key JSON (base64 -i key.json | tr -d '\n').
# Empty (and DRIVE_SYNC_USE_FAKE=false) = feature off, /v1/me/drive answers 503.
DRIVE_SYNC_SERVICE_ACCOUNT_JSON=
DRIVE_SYNC_ENABLED=false
DRIVE_SYNC_INTERVAL=PT30M
DRIVE_SYNC_RUN_BUDGET=PT10M
DRIVE_SYNC_MAX_FILE_BYTES=52428800
DRIVE_SYNC_USE_FAKE=false
# Per-source time slice, reference (no-copy) threshold and walk caps (docs/DRIVE-SYNC.md).
DRIVE_SYNC_SOURCE_BUDGET=PT3M
DRIVE_SYNC_REFERENCE_ABOVE_BYTES=20971520
DRIVE_SYNC_MAX_ITEMS_PER_SOURCE=20000
DRIVE_SYNC_MAX_DEPTH=30
# Community archives (one source per subject folder); ONLY_CODES limits expansion (dev).
DRIVE_SYNC_COMMUNITY_ENABLED=true
DRIVE_SYNC_COMMUNITY_ONLY_CODES=

# Subject wiki pipeline (docs/SUBJECT-WIKI-PIPELINE.md, docs/SUBJECT-WIKI-ADMIN.md).
# DigitalOcean serverless inference key; empty = dry runs only.
KB_LLM_API_KEY=
KB_LLM_BASE_URL=https://inference.do-ai.run
KB_LLM_USE_FAKE=false
# auto (batch for models that support it, sync otherwise) | batch | sync
KB_EXECUTION_MODE=auto
KB_SYNC_CONCURRENCY=4
# Weekly run (manual runs and evals work regardless).
KB_PIPELINE_ENABLED=false
KB_PIPELINE_CRON=0 0 3 * * SUN
# Safety sweep (runs are advanced as soon as they are triggered).
KB_POLL_INTERVAL=PT10M
# DO batch status polling, only while a batch is open.
KB_BATCH_POLL_INTERVAL=PT1M
KB_MODEL_DIGEST=glm-5.3-flash
KB_MODEL_PLAN=glm-5.3
KB_MODEL_WRITE=glm-5.3
# Empty = the write model.
KB_MODEL_RETRY=
KB_RUN_TOKEN_BUDGET=3000000
# The API's own object writes go here (compose default http://minio:9000).
STORAGE_INTERNAL_ENDPOINT=
# Local dev only (needs the dev profile): POST /v1/auth/dev-login.
AUTH_DEV_LOGIN_ENABLED=false

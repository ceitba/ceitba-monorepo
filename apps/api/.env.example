# Server Configuration
PORT=3000
NODE_ENV=development

# API Tokens
ITBA_API_TOKEN=your_itba_api_token_here
ITBA_API_BASE_URL=https://url.here/example
ITBA_API_TIMEOUT=30000
SUPABASE_ACCESS_TOKEN=your_supabase_access_token_here

POSTGRES_DB=ceitba_db
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_secure_password
DATABASE_URL=postgresql://your_username:your_secure_password@localhost:5432/ceitba_db

# Cron Jobs (optional)
ENABLE_CRON=false

# CORS Origins (comma-separated)
# CORS_ORIGINS=https://ceitba.org.ar,http://localhost:3000,http://localhost:3001

# Logging Level
LOG_LEVEL=info

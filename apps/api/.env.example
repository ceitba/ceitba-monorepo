# --- Server ---
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- Database ---
POSTGRES_DB=ceitba_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ceitba_password
DATABASE_URL=jdbc:postgresql://localhost:5432/ceitba_db

# --- ITBA External API ---
ITBA_API_BASE_URL=https://example.com
ITBA_API_TOKEN=your_itba_api_token_here
ITBA_API_TIMEOUT=30000
# Set to true in tests/local-dev to swap in FakeItbaApiClient (no network calls).
ITBA_API_USE_FAKE=false
# SGA academic prefill (file number / career / plan) after login and on
# POST /v1/me/profile/sync-from-sga. Only emails on the domain are looked up.
ITBA_PROFILE_SYNC_ENABLED=true
ITBA_PROFILE_SYNC_EMAIL_DOMAIN=itba.edu.ar

# --- Auth ---
# Comma-separated list. Email is admitted if it ends with @<one_of_these>.
AUTH_ALLOWED_DOMAINS=itba.edu.ar
# Comma-separated explicit allowlist for non-domain users (staff/alumni on personal addresses).
AUTH_ALLOWED_EMAILS=
# Required for /v1/sync/** endpoints.
# openssl rand -hex 32
AUTH_SYNC_API_KEY=change-me-in-prod

# --- Sync ---
# Set to true to enable the @Scheduled twice-daily sync job (00:00 and 12:00).
SYNC_ENABLED=false

# --- Rate limiting (per client IP, in-memory) ---
# Applies to /v1/auth/** except /v1/auth/me and /v1/auth/api-keys/**.
# (The docker-compose ceitba-api service passes these through.)
RATE_LIMIT_ENABLED=true
# Use the right-most X-Forwarded-For entry (set by Caddy). Only honoured when
# the direct peer is a private/loopback address (the proxy). Set to false when
# the API is exposed without a reverse proxy.
RATE_LIMIT_TRUST_FORWARDED_FOR=true
RATE_LIMIT_AUTH_CAPACITY=20
RATE_LIMIT_AUTH_PERIOD=1m
# Separate bucket for POST /v1/auth/google/mobile (class-wide installs behind
# the campus NAT).
RATE_LIMIT_MOBILE_LOGIN_CAPACITY=120
RATE_LIMIT_MOBILE_LOGIN_PERIOD=1m
# Separate bucket for POST /v1/auth/refresh (mobile apps refresh every ~15 min).
RATE_LIMIT_REFRESH_CAPACITY=120
RATE_LIMIT_REFRESH_PERIOD=1m

# --- Google OAuth ---
# openssl rand -base64 32
AUTH_JWT_SECRET=
# Optional root secret for content hashes (proposal attachment keys, imported
# Firestore comment ids). Empty = keys are derived from AUTH_JWT_SECRET, so
# rotating that secret invalidates unattached uploads and makes a Firestore
# import re-run duplicate legacy comments. openssl rand -base64 32
CONTENT_HMAC_SECRET=
# Web session cookie lifetime.
AUTH_JWT_TTL_DAYS=7
# `iss` of the JWTs we issue (the public API base URL).
AUTH_JWT_ISSUER=https://ceitba.org.ar/api
# Phase-in: false = iss/aud checked only on tokens that carry them. Set to true
# once all pre-B1 web cookies have expired (B1 deploy date + AUTH_JWT_TTL_DAYS).
AUTH_JWT_ENFORCE_ISS_AUD=false
# Mobile app tokens (POST /v1/auth/google/mobile, /v1/auth/refresh).
AUTH_MOBILE_ACCESS_TTL=15m
AUTH_REFRESH_TTL=60d
# A rotated refresh token re-presented within this window (lost response) gets
# a new successor instead of revoking the whole session family. 0 disables.
AUTH_REFRESH_REUSE_GRACE=60s
# Comma-separated OAuth client IDs accepted as `aud` of Google ID tokens from
# the mobile app: the web client ID below (the app's serverClientId) and, if
# the iOS app does not use serverClientId, the iOS client ID. All clients must
# be in the same Google Cloud project. Empty = mobile login disabled.
AUTH_GOOGLE_MOBILE_AUDIENCES=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/callback

# --- Session cookie ---
# HttpOnly is forced in code; the rest is configurable so prod can flip Secure
# on and pin the cookie to ceitba.org.ar, while local dev runs in plain http.
AUTH_COOKIE_NAME=ceitba_session
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_PATH=/

FRONTEND_URL=http://localhost:3000

# --- Mobile app release control (GET /v1/app/config) ---
MOBILE_MIN_VERSION=0.0.0
MOBILE_LATEST_VERSION=0.0.0
MOBILE_MAINTENANCE=false

# --- Push notifications (FCM, docs/PUSH-NOTIFICATIONS.md) ---
# Service-account key JSON of the app's Firebase project, raw or base64
# (base64 -i key.json), or a path to the file. Both empty = pushes disabled
# (device registration still works). Invalid credentials fail startup.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

# --- Object storage (Cloudflare R2, S3-compatible) ---
# Presigned direct uploads for CMS images and proposal attachments. Leave any
# of these empty to disable uploads (the sign-upload endpoints answer 501).
# R2_ENDPOINT is https://<account-id>.r2.cloudflarestorage.com; R2_PUBLIC_URL
# is the bucket's public (r2.dev or custom) domain. Use an R2 API token scoped
# to Object Read & Write on this bucket only.
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
R2_PRESIGN_TTL=10m
# Per-user quota on proposal attachment upload signing.
RATE_LIMIT_PROPOSAL_ATTACHMENTS_CAPACITY=30
RATE_LIMIT_PROPOSAL_ATTACHMENTS_PERIOD=1h
# Per-user quotas on POST /v1/proposals and POST /v1/proposals/{id}/comments.
RATE_LIMIT_PROPOSALS_CAPACITY=10
RATE_LIMIT_PROPOSALS_PERIOD=1h
RATE_LIMIT_PROPOSAL_COMMENTS_CAPACITY=30
RATE_LIMIT_PROPOSAL_COMMENTS_PERIOD=10m

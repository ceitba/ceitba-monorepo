{
  "name": "api",
  "version": "1.0.0",
  "description": "",
  "main": "server.ts",
  "scripts": {
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "build": "nest build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "update": "npx ts-node v1/itba/itbagw/update.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "npx ts-node -r tsconfig-paths/register prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "docker:db:up": "docker-compose up postgres -d",
    "docker:db:down": "docker-compose down postgres",
    "docker:dev": "docker-compose up ceitba-api-dev",
    "docker:dev:watch": "docker-compose watch",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up ceitba-api-prod -d",
    "docker:prod:down": "docker-compose -f docker-compose.prod.yml down",
    "docker:logs": "docker-compose logs -f ceitba-api-dev",
    "docker:logs:prod": "docker-compose -f docker-compose.prod.yml logs -f ceitba-api-prod"
  },
  "author": "urielsv",
  "license": "ISC",
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/schedule": "6.0.0",
    "@nestjs/swagger": "11.2.0",
    "@supabase/supabase-js": "2.57.4",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cors": "2.8.5",
    "date-fns": "4.1.0",
    "dotenv": "16.4.7",
    "fs": "0.0.1-security",
    "node-cron": "3.0.3",
    "node-fetch": "3.3.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.7",
    "@nestjs/testing": "11.1.6",
    "@prisma/client": "6.16.1",
    "@types/cors": "2.8.19",
    "@types/jest": "29.5.14",
    "@types/node": "22.7.4",
    "@types/node-cron": "3.0.11",
    "jest": "29.7.0",
    "nodemon": "3.1.10",
    "prisma": "6.16.1",
    "ts-jest": "29.4.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.2"
  }
}

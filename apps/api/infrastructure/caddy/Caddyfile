www.ceitba.org.ar {
    redir https://ceitba.org.ar{uri} permanent
}

ceitba.org.ar {
    handle /api/* {
        reverse_proxy ceitba-api:8080
    }

    handle /scheduler* {
        root * /var/www/scheduler
        uri strip_prefix /scheduler
        file_server
        try_files {path} /index.html
    }

    handle /itbanews* {
        root * /var/www/itbanews
        uri strip_prefix /itbanews
        file_server
        try_files {path} /index.html
    }

    handle {
        root * /var/www/main
        file_server
        try_files {path} /index.html
    }
}

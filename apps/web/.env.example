# Base URL path for deployment (e.g. / for root, /ceitba for subdirectory)
VITE_BASE_PATH=/

# API base URL — must include /v1 suffix and be on the same registrable
# domain as the SPA so the session cookie is shared across all CEITBA SPAs.
VITE_API_URL=http://localhost:8080/api/v1

# Where Google sends the browser back after sign-in.
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# Local development only: "true" adds a /dev-login page (and a "Dev login"
# link next to "Iniciar sesión") that signs in through CEITBA-API's
# POST /v1/auth/dev-login, which only exists with the API's `dev` profile and
# AUTH_DEV_LOGIN_ENABLED=true. Ignored by `npm run build` (only honoured by
# the Vite dev server), so it never reaches production.
VITE_DEV_LOGIN=false

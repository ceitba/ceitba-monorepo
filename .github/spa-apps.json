[
  {
    "app": "web",
    "package": "@ceitba/web",
    "dir": "apps/web",
    "www": "main",
    "env": {
      "VITE_BASE_PATH": "/",
      "VITE_API_URL": "https://ceitba.org.ar/api/v1",
      "VITE_GOOGLE_REDIRECT_URI": "https://ceitba.org.ar/auth/callback"
    }
  },
  {
    "app": "scheduler",
    "package": "@ceitba/scheduler",
    "dir": "apps/scheduler",
    "www": "scheduler",
    "env": {
      "VITE_BASE_PATH": "/scheduler/",
      "VITE_CEITBA_API_URL": "https://ceitba.org.ar",
      "VITE_GOOGLE_REDIRECT_URI": "https://ceitba.org.ar/scheduler/auth/callback"
    }
  },
  {
    "app": "newsletter",
    "package": "@ceitba/newsletter",
    "dir": "apps/newsletter",
    "www": "itbanews",
    "env": {
      "VITE_BASE_PATH": "/newsletter/",
      "VITE_API_URL": "https://ceitba.org.ar/api/v1",
      "VITE_GOOGLE_REDIRECT_URI": "https://ceitba.org.ar/newsletter/admin/callback"
    }
  }
]

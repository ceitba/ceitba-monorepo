www.ceitba.org.ar {
    redir https://ceitba.org.ar{uri} permanent
}

ceitba.org.ar {
    # Hosted MCP server (apps/mcp, ~/CEITBA-MCP) at https://ceitba.org.ar/mcp.
    # It owns /mcp, /mcp/* (MCP endpoint, OAuth endpoints, Google callback)
    # and the two path-suffixed discovery documents MCP clients fetch
    # (RFC 9728 / RFC 8414 put the issuer path after /.well-known/...).
    # Nothing else at the root is forwarded. No prefix stripping: the app
    # serves these exact paths. MCP responses can stream (SSE), so flush
    # immediately.
    @mcp path /mcp /mcp/* /.well-known/oauth-protected-resource/mcp /.well-known/oauth-authorization-server/mcp /.well-known/openid-configuration/mcp
    handle @mcp {
        request_body {
            max_size 1MB
        }
        reverse_proxy ceitba-mcp:8787 {
            flush_interval -1
        }
    }
    # The API runs as two colors (blue/green, apps/api/docs/DEPLOY.md): a
    # deploy starts the idle one, waits for it to be healthy and stops the
    # other. Caddy health-checks each upstream every 2s and sends traffic only
    # to the first healthy one; while one is booting or gone, requests that
    # can't reach an upstream are retried for up to 15s instead of failing.
    # A color that isn't running doesn't resolve and simply counts as down.
    #
    # ceitba-api:8080 is the pre-blue/green container: the fallback for the
    # first blue/green deploy, while blue boots next to it. Remove it in the
    # next release (expand/contract).
    handle /api/* {
        reverse_proxy ceitba-api-blue:8080 ceitba-api-green:8080 ceitba-api:8080 {
            lb_policy first
            lb_try_duration 15s
            lb_try_interval 250ms
            health_uri /api/actuator/health
            health_interval 2s
            health_timeout 2s
        }
    }

    # Object storage (MinIO, in the CEITBA-API compose project, reachable here
    # over the ceitba-proxy network). Path style: the bucket is the first path
    # segment, so https://ceitba.org.ar/ceitba-media/<key> is both the
    # presigned PUT target and the public GET URL. No path stripping and no
    # Host rewrite: reverse_proxy forwards the client's Host (ceitba.org.ar)
    # unchanged, which is the host the API signed the URL for; changing it
    # breaks every SigV4 signature. Uploads are at most 10 MB
    # (MediaUploadService); the body limit leaves headroom.
    # Tested by MinioPresignedUploadIT, which runs this exact block.
    handle /ceitba-media/* {
        request_body {
            max_size 12MB
        }
        reverse_proxy ceitba-minio:9000
    }

    # The newsletter's canonical path is /newsletter (served by the web app
    # below, like /scheduler). /itbanews is kept as a permanent redirect for
    # old links.
    @itbanews path_regexp itbanews ^/itbanews(/.*)?$
    handle @itbanews {
        redir * /newsletter{re.itbanews.1}{?query} permanent
    }

    # The web app: the site, /scheduler and /newsletter, all one SPA.
    handle {
        root * /var/www/main
        # CEITBApp's Universal Links (iOS): the file has no extension, so
        # Caddy can't infer the JSON type Apple expects.
        header /.well-known/apple-app-site-association Content-Type application/json
        file_server
        try_files {path} /index.html
    }
}
